<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Pages 3 and 4: one table per category. The controller is set by MainController with the
     income or the expense view model. -->
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" styleClass="page">
    <HBox spacing="16" alignment="CENTER_LEFT">
        <Label fx:id="title" styleClass="page-title"/>
        <HBox styleClass="term-tabs">
            <ToggleButton fx:id="month1" text="1st month" minWidth="-Infinity"/>
            <ToggleButton fx:id="month2" text="2nd month" minWidth="-Infinity"/>
            <ToggleButton fx:id="month3" text="3rd month" minWidth="-Infinity"/>
        </HBox>
        <HBox spacing="8" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
            <TextField fx:id="newCategory" promptText="New category name" prefColumnCount="16"/>
            <Button text="Add category" onAction="#addCategory" minWidth="-Infinity"/>
        </HBox>
    </HBox>
    <Label fx:id="error"/>
    <ScrollPane fx:id="scroll" fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS"
                styleClass="edge-to-edge">
        <VBox fx:id="sections" spacing="16" style="-fx-padding: 0 4 16 0;"/>
    </ScrollPane>
</VBox>
