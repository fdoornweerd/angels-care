<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<!-- The window: a top bar with Back and the breadcrumb, the open page, a footer for support. -->
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.angelscare.management.shell.ui.MainController"
            stylesheets="@../../css/app.css">
    <top>
        <HBox styleClass="top-bar">
            <Label text="Angels Care" styleClass="app-title"/>
            <Button fx:id="back" text="‹ Back" onAction="#back" minWidth="-Infinity"/>
            <Label fx:id="breadcrumb" styleClass="breadcrumb"/>
        </HBox>
    </top>
    <center>
        <StackPane fx:id="content"/>
    </center>
    <bottom>
        <Label fx:id="footer" styleClass="footer" maxWidth="Infinity"/>
    </bottom>
</BorderPane>
